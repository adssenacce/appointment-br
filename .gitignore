```gitignore
# Database files
*.db

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage reports
.coverage
htmlcov/
coverage/

# Temporary files
*.tmp
*.temp

# Environment variables
.env
.env.local
*.env.*

# Build artifacts
dist/
build/
target/
*.so
*.dylib
*.dll
*.exe
*.out

# Package management
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/

# OS generated files
.DS_Store
Thumbs.db
```